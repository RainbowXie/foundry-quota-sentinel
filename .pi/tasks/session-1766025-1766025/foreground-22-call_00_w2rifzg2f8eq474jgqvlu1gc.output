func makeQuotaQuerier() *opencode.OpenCodeQuerier {
	q := opencode.NewOpenCodeQuerier()
	if q.Cookie == "" || q.WorkspaceID == "" {
		if p, ok := cfg.GetActiveProfile(); ok {
			if q.Cookie == "" {
				q.Cookie = p.Cookie
			}
			if q.WorkspaceID == "" {
				q.WorkspaceID = p.WorkspaceID
			}
		}
	}
	return q
}

