2388:            // loginShellPoll polls a provider's shell endpoint until the
2389-            // named account appears (name-presence; OpenCode/Ollama have no
2390-            // generation counter), then renders all shells immediately and
2391-            // triggers the single-flight fill (fillFn is the provider's
2392-            // fq/fo wrapper). A cancelled/failed login never writes the
2393-            // account, so no ghost shell can appear. The shell fetch itself
2394-            // is a local config read (no quota request); only the fill fires
2395-            // once the account is confirmed present. The poll is BOUNDED
2396-            // (maxTries × interval, ~5min at 1s, aligned with DeepSeek's
2397-            // dsLoginPoll): a login browser can stay open for minutes, but
2398-            // if the user abandons the login the recursive setTimeout must
2399-            // stop — otherwise it polls every second forever (resource
2400-            // leak). After the window expires, the periodic 30s refresh
2401-            // picks up the account if it eventually lands.
2402:            function loginShellPoll(shellFn, fillFn, name, interval, maxTries) {
2403-                var tries = 0;
2404-                function tick() {
2405-                    shellFn().then(function (present) {
2406-                        if (present) {
2407-                            return fillFn();
2408-                        }
2409-                        if (tries++ < maxTries) setTimeout(tick, interval);
2410-                    }).catch(function () {
2411-                        // Transient shell fetch error: keep polling within
2412-                        // the bound.
2413-                        if (tries++ < maxTries) setTimeout(tick, interval);
2414-                    });
2415-                }
2416-                tick();
2417-            }
