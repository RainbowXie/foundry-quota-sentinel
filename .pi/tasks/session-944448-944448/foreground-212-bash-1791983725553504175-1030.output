+// SaveOpenCodeProfile 原子持久化 OpenCode 账户凭证与 WorkspaceID。
+func SaveOpenCodeProfile(name, cookie, wsid string) error {
+	return Mutate(func(c *Config) error {
+		c.AddProfile(name, Profile{Cookie: cookie, WorkspaceID: wsid})
+		return nil
+	})
+}
