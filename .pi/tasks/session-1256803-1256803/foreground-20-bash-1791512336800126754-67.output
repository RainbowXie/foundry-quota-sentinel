<body>
  <script>
    const savedColorScheme = localStorage.getItem("oc:color-scheme")
    document.documentElement.dataset.colorScheme = savedColorScheme === "light" || savedColorScheme === "dark"
      ? savedColorScheme
      : window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light"
    if (typeof performance !== "undefined" && typeof performance.now === "function") {
      performance.now = performance.now.bind(performance)
    }
    if (typeof crypto !== "undefined" && typeof crypto.getRandomValues === "function") {
      crypto.getRandomValues = crypto.getRandomValues.bind(crypto)
    }
    if (typeof fetch === "function") {
      globalThis.fetch = globalThis.fetch.bind(globalThis)
    }
    if (typeof setTimeout === "function") {
      globalThis.setTimeout = globalThis.setTimeout.bind(globalThis)
      globalThis.clearTimeout = globalThis.clearTimeout.bind(globalThis)
    }
    if (typeof setInterval === "function") {
      globalThis.setInterval = globalThis.setInterval.bind(globalThis)
      globalThis.clearInterval = globalThis.clearInterval.bind(globalThis)
    }
  </script>
  <div id="app"></div>
</body>
