+// openCodeCaptureErr 给凭证捕获失败的结论补上最后一次 CDP 探针错误，
+// 避免用户只看到笼统提示而无法定位故障来源。
+func openCodeCaptureErr(reason string, probeErr error) error {
+	if probeErr == nil {
+		return errors.New(reason)
+	}
+	return fmt.Errorf("%s: %w", reason, probeErr)
+}
