 func TestRunOpenCodeLoginKeepsPollingWhenOrgIDResolveFails(t *testing.T) {
 	browser := newFakeOpenCodeBrowser("console_session=good", "https://opencode.ai/console/go", func() {})
 	browser.exited = true
