+// shouldResolveOpenCodeOrgID 判断本轮轮询是否允许发起默认组织反查。
+func shouldResolveOpenCodeOrgID(attempts int, nextAllowed, now time.Time) bool {
+	return attempts < openCodeOrgResolveMaxAttempts && !now.Before(nextAllowed)
+}
