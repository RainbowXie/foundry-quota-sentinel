		if acc == nil || acc.Token == "" {
			pageErr(fmt.Sprintf("DeepSeek 账户 %q 不存在或缺少凭证", name))
		}
		url := "https://platform.deepseek.com/usage"
		if err := auth.RunDeepSeekPage(url, acc.WebStore); err != nil {
